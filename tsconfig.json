{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "eslint.config.ts",
  ],

  "exclude": [
    "node_modules",
  ],
}
